# Copy to .env.prod on the server and fill in real values.
#   cp .env.prod.example .env.prod   &&   nano .env.prod
# NEVER commit .env.prod — it holds secrets.

# --- Database (kept inside the Docker network; not exposed to the host) ---
POSTGRES_DB=uttarshalldb
POSTGRES_USER=uttarshall
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_long_random_secret

DEBUG=False

# Your VM's public IP and/or domain (comma-separated, no spaces).
# e.g. ALLOWED_HOSTS=valley.duckdns.org,123.45.67.89
ALLOWED_HOSTS=YOUR_VM_PUBLIC_IP

# Needed for Django admin login once you're on HTTPS (must include scheme).
# e.g. CSRF_TRUSTED_ORIGINS=https://valley.duckdns.org
CSRF_TRUSTED_ORIGINS=

# Leave empty when the SPA and API share one origin (the default setup).
CORS_ALLOWED_ORIGINS=

# Flip to True ONLY after a TLS certificate is in place (see DEPLOY.md).
USE_HTTPS=False

# --- AI travel-guide agent (optional) ---
# The agent uses OpenAI embeddings + chat. Leave blank to run the site
# without the agent; the rest of the app works fine. See DEPLOY.md notes.
OPENAI_API_KEY=
