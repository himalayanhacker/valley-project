# Multi-stage: build the Vite SPA, then serve the static output with Nginx.
# Nginx also reverse-proxies /api, /admin, /static and /media to the backend,
# so the whole site is served from a single origin (no CORS needed).

# ---- Stage 1: build ----
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci || npm install
COPY . .
RUN npm run build

# ---- Stage 2: serve ----
FROM nginx:1.27-alpine
# Built SPA assets
COPY --from=build /app/dist /usr/share/nginx/html
# Our reverse-proxy + SPA-fallback config
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
